generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MissionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
}

enum RewardStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum TransactionType {
  EARN
  REDEEM
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  pointsBalance Int        @default(0)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile         Profile?
  sessions        Session[]
  missionProgress UserMissionProgress[]
  redemptions     Redemption[]
  transactions    Transaction[]
  notifications   Notification[]
  achievements   UserAchievement[]
  supportTickets  SupportTicket[]
  adminActions    AdminAuditLog[] @relation("AdminActions")
  authTokens      AuthToken[]

  @@index([role, status])
  @@index([createdAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  avatarUrl String?
  bio       String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  games Game[]
}

model Game {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  thumbnail   String?
  launchUrl   String?
  categoryId  String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  missions Mission[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model Mission {
  id          String        @id @default(cuid())
  title       String
  description String?
  gameId      String?
  points      Int
  targetValue Int           @default(1)
  status      MissionStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  game     Game?                  @relation(fields: [gameId], references: [id], onDelete: SetNull)
  progress UserMissionProgress[]

  @@index([status, startsAt, endsAt])
  @@index([gameId])
}

model UserMissionProgress {
  id           String         @id @default(cuid())
  userId       String
  missionId    String
  currentValue Int            @default(0)
  status       ProgressStatus @default(IN_PROGRESS)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  claimedAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, status])
}

model Reward {
  id          String       @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  pointsCost  Int
  stock       Int?
  status      RewardStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  redemptions Redemption[]

  @@index([status, pointsCost])
}

model Redemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  status      RedemptionStatus @default(PENDING)
  reference   String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  type         TransactionType
  status       TransactionStatus @default(COMPLETED)
  points       Int
  balanceAfter Int
  description  String?
  reference    String?           @unique
  createdAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, priority])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}
